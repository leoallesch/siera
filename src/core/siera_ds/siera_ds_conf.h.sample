/*
 * siera_ds_conf.h — datasource key definitions
 *
 * HOW TO USE
 * ----------
 * 1. Copy this file to your project as "siera_ds_conf.h".
 * 2. Replace the example keys with your own.
 * 3. Add the directory containing siera_ds_conf.h to your target's include path:
 *
 *      target_include_directories(my_app PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
 *
 *    The library locates this file automatically via __has_include("siera_ds_conf.h").
 *    If no config is found, the library falls back to a single dummy key so it
 *    compiles cleanly without any user configuration.
 *
 * KEY FORMAT
 * ----------
 * Each entry inside SIERA_DS_KEYS(KEY) has the form:
 *
 *   KEY(name, c_type, stream_type, default_value, flags)
 *
 *   name          Identifier suffix.  "BRIGHTNESS" → SIERA_DS_KEY_BRIGHTNESS.
 *   c_type        C type stored in the cache (uint8_t, bool, float, …).
 *   stream_type   Where the value lives:
 *                   SIERA_DS_RAM     — volatile, in-memory only
 *                   SIERA_DS_NVS — non-volatile, read/written via persist stream
 *                   SIERA_DS_GPIO    — backed by a GPIO stream
 *                   SIERA_DS_ADC     — backed by an ADC stream (read-only typical)
 *                   SIERA_DS_PWM     — backed by a PWM stream
 *                   SIERA_DS_I2C     — backed by an I2C stream
 *                   SIERA_DS_SPI     — backed by a SPI stream
 *   default_value Compile-time constant applied on siera_ds_init().
 *   flags         SIERA_DS_NONE | SIERA_DS_READONLY | SIERA_DS_SILENT
 *                   SIERA_DS_READONLY  siera_ds_write() returns -1
 *                   SIERA_DS_SILENT    writes do not publish change events
 */

#define SIERA_DS_KEYS(KEY) \
    KEY(MY_VALUE, uint8_t, SIERA_DS_RAM, 0, SIERA_DS_NONE)
